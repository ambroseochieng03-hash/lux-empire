            <?php endforeach; ?>

        </div>

        <div class="lux-card" style="padding:20px; border-radius:30px;">
            <div id="map"></div>
        </div>

        <script>
            window.LUX_TRACK_CONFIG = {
                baseUrl: "<?php echo BASE_URL; ?>",
                trips: <?php echo json_encode(array_map(static function ($t) {
                    return [
                        'id' => (int) $t['id'],
                        'driverId' => (int) $t['driver_id'],
                        'status' => $t['status'],
                        'pickup' => [
                            'lat' => (float) ($t['pickup_lat'] ?: -1.286389),
                            'lng' => (float) ($t['pickup_lng'] ?: 36.817223),
                        ],
                        'destination' => [
                            'lat' => (float) ($t['destination_lat'] ?: -1.286389),
                            'lng' => (float) ($t['destination_lng'] ?: 36.817223),
                        ],
                    ];
                }, $trips)); ?>
            };
        </script>

        <script>
        (function () {
            const cfg = window.LUX_TRACK_CONFIG;
            const tripsById = {};
            cfg.trips.forEach(t => { tripsById[t.id] = t; });

            const selected = new Set(cfg.trips.map(t => t.id));
            const markers = {};       // tripId -> google.maps.Marker
            const fullPathLines = {}; // tripId -> polyline (single-select route only)
            const remainingLines = {};
            let map, directionsService;
            let lastRouteCallAt = 0;

            function getCurrentTarget(trip) {
                return trip.status === 'in_transit' ? trip.destination : trip.pickup;
            }

            function buildPrecisePath(route) {
                const path = [];
                route.legs.forEach(leg => {
                    leg.steps.forEach(step => {
                        step.path.forEach(point => path.push(point));
                    });
                });
                return path;
            }

            function refreshCardStyles() {
                document.querySelectorAll('.track-trip-card').forEach(card => {
                    const id = parseInt(card.dataset.tripCard, 10);
                    card.classList.toggle('is-selected', selected.has(id));
                    const box = document.querySelector(`[data-eta-box="${id}"]`);
                    if (box) box.style.display = (selected.size === 1 && selected.has(id)) ? 'block' : 'none';
                });
            }

            function fitBoundsToSelected() {
                const bounds = new google.maps.LatLngBounds();
                let any = false;
                selected.forEach(id => {
                    const marker = markers[id];
                    if (marker && marker.getPosition()) {
                        bounds.extend(marker.getPosition());
                        any = true;
                    }
                });
                if (any) map.fitBounds(bounds, 60);
            }

            function clearRouteLines(id) {
                if (fullPathLines[id]) { fullPathLines[id].setMap(null); delete fullPathLines[id]; }
                if (remainingLines[id]) { remainingLines[id].setMap(null); delete remainingLines[id]; }
            }

            function updateSingleTripRoute(id, driverPos) {
                const now = Date.now();
                if (now - lastRouteCallAt < 3000) return;
                lastRouteCallAt = now;

                const trip = tripsById[id];

                directionsService.route({
                    origin: driverPos,
                    destination: getCurrentTarget(trip),
                    travelMode: google.maps.TravelMode.DRIVING
                }, function (result, status) {
                    if (status !== "OK") return;

                    const route = result.routes[0];
                    const leg = route.legs[0];
                    const precisePath = buildPrecisePath(route);

                    if (!fullPathLines[id]) {
                        fullPathLines[id] = new google.maps.Polyline({
                            strokeColor: "#888888", strokeOpacity: 0.6, strokeWeight: 6, map: map
                        });
                    }
                    if (!remainingLines[id]) {
                        remainingLines[id] = new google.maps.Polyline({
                            strokeColor: "#4285F4", strokeOpacity: 1, strokeWeight: 6, map: map
                        });
                    }

                    fullPathLines[id].setPath(precisePath);
                    remainingLines[id].setPath(precisePath);

                    const etaEl = document.querySelector(`[data-eta-text="${id}"]`);
                    const distEl = document.querySelector(`[data-distance-text="${id}"]`);
                    if (etaEl) etaEl.textContent = leg.duration.text;
                    if (distEl) distEl.textContent = leg.distance.text;
                });
            }

            function fetchDriverLocation(id) {
                const trip = tripsById[id];
                if (!trip || !trip.driverId) return;

                fetch(`${cfg.baseUrl}/api/maps/get_driver_location.php?driver_id=${trip.driverId}`)
                    .then(r => r.json())
                    .then(data => {
                        if (!data.success) return;

                        const pos = {
                            lat: parseFloat(data.location.latitude),
                            lng: parseFloat(data.location.longitude)
                        };

                        if (!markers[id]) {
                            markers[id] = new google.maps.Marker({
                                map: map,
                                title: 'Trip #' + id,
                                icon: { url: "https://maps.google.com/mapfiles/ms/icons/blue-dot.png" },
                                label: { text: String(id), color: '#000', fontWeight: 'bold' }
                            });
                        }

                        markers[id].setPosition(pos);

                        if (selected.size === 1 && selected.has(id)) {
                            updateSingleTripRoute(id, pos);
                        }

                        if (selected.has(id)) fitBoundsToSelected();
                    })
                    .catch(() => {});
            }

            function pollTripStatus(id) {
                fetch(`${cfg.baseUrl}/api/trucks/get_trip_status.php?trip_id=${id}`)
                    .then(r => r.json())
                    .then(data => {
                        if (!data.status) return;

                        const stillActive = ['accepted', 'arrived_at_pickup', 'in_transit'].includes(data.status);

                        if (!stillActive) {
                            // Trip finished/cancelled — drop it from the map and the grid
                            // entirely, matching the "everything hidden once completed" rule.
                            if (markers[id]) { markers[id].setMap(null); delete markers[id]; }
                            clearRouteLines(id);
                            selected.delete(id);
                            delete tripsById[id];

                            const card = document.querySelector(`[data-trip-card="${id}"]`);
                            if (card) card.remove();

                            if (Object.keys(tripsById).length === 0) {
                                window.location.reload();
                            }
                            return;
                        }

                        const pill = document.querySelector(`[data-trip-card="${id}"] .track-trip-status-pill`);
                        if (pill && trip.status !== data.status) {
                            tripsById[id].status = data.status;
                            pill.className = 'track-trip-status-pill track-trip-status-' + data.status;
                            pill.textContent = data.status.toUpperCase().replace('_', ' ');
                        }
                    })
                    .catch(() => {});
                var trip = tripsById[id] || {};
            }

            function pollAll() {
                selected.forEach(id => fetchDriverLocation(id));
                Object.keys(tripsById).forEach(id => pollTripStatus(parseInt(id, 10)));
            }

            function initMap() {
                const firstTrip = cfg.trips[0];
                map = new google.maps.Map(document.getElementById("map"), {
                    zoom: 13,
                    center: firstTrip ? firstTrip.pickup : { lat: -1.286389, lng: 36.817223 },
                    mapTypeControl: false,
                    streetViewControl: false,
                    fullscreenControl: true
                });

                directionsService = new google.maps.DirectionsService();

                pollAll();
                setInterval(pollAll, 2000);
            }

            document.querySelectorAll('.track-trip-checkbox').forEach(cb => {
                cb.addEventListener('change', function () {
                    const id = parseInt(this.dataset.tripId, 10);
                    if (this.checked) {
                        selected.add(id);
                    } else {
                        selected.delete(id);
                        if (markers[id]) markers[id].setMap(map); // keep marker visible but stop route
                        clearRouteLines(id);
                    }
                    refreshCardStyles();
                    fitBoundsToSelected();
                });
            });

            document.querySelectorAll('.track-only-this-btn').forEach(btn => {
                btn.addEventListener('click', function () {
                    const id = parseInt(this.dataset.tripId, 10);
                    selected.clear();
                    selected.add(id);
                    document.querySelectorAll('.track-trip-checkbox').forEach(cb => {
                        cb.checked = (parseInt(cb.dataset.tripId, 10) === id);
                    });
                    Object.keys(tripsById).forEach(tid => { if (parseInt(tid,10) !== id) clearRouteLines(parseInt(tid,10)); });
                    refreshCardStyles();
                    fitBoundsToSelected();
                });
            });

            document.getElementById('trackSelectAllBtn').addEventListener('click', function () {
                document.querySelectorAll('.track-trip-checkbox').forEach(cb => {
                    cb.checked = true;
                    selected.add(parseInt(cb.dataset.tripId, 10));
                });
                refreshCardStyles();
                fitBoundsToSelected();
            });

            document.getElementById('trackClearAllBtn').addEventListener('click', function () {
                document.querySelectorAll('.track-trip-checkbox').forEach(cb => {
                    cb.checked = false;
                });
                selected.clear();
                Object.keys(tripsById).forEach(id => clearRouteLines(parseInt(id, 10)));
                refreshCardStyles();
            });

            window.initMap = initMap;
        })();
        </script>

        <script
            async
            defer
            src="https://maps.googleapis.com/maps/api/js?key=<?php echo GOOGLE_MAPS_API_KEY; ?>&callback=initMap">
        </script>

    <?php endif; ?>

</main>
</div>

<?php require_once '../../includes/chat_starter_modal.php'; ?>

